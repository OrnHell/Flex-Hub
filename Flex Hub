-- ESP, Uyarı & Anti-Kill Döngüsü
RunService.RenderStepped:Connect(function()
    if Toggles.RoleESP then
        for _, plr in pairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
                local char = plr.Character
                local hl = char:FindFirstChild("FlexHighlight") or Instance.new("Highlight")
                hl.Name = "FlexHighlight"
                hl.Parent = char

                if char:FindFirstChild("Knife") or plr.Backpack:FindFirstChild("Knife") then
                    hl.FillColor = Color3.fromRGB(255, 0, 0)
                elseif char:FindFirstChild("Gun") or plr.Backpack:FindFirstChild("Gun") then
                    hl.FillColor = Color3.fromRGB(0, 120, 255)
                else
                    hl.FillColor = Color3.fromRGB(0, 255, 100)
                end
                hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                hl.FillTransparency = 0.4
            end
        end
    end

    if Toggles.DroppedGunESP then
        local gunDrop = GetDroppedGun()
        if gunDrop then
            local hl = gunDrop:FindFirstChild("GunHighlight") or Instance.new("Highlight")
            hl.Name = "GunHighlight"
            hl.Parent = gunDrop
            hl.FillColor = Color3.fromRGB(255, 255, 0)
            hl.OutlineColor = Color3.fromRGB(255, 255, 255)
            hl.FillTransparency = 0.2
        end
    end

    local murd = GetMurderer()
    if murd and murd.Character and murd.Character:FindFirstChild("HumanoidRootPart") and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        local dist = (LocalPlayer.Character.HumanoidRootPart.Position - murd.Character.HumanoidRootPart.Position).Magnitude
        
        if Toggles.MurdererWarning then
            if dist <= 25 and not MurdererWarned then
                MurdererWarned = true
                WindUI:Notify({ Title = "DİKKAT!", Content = "Katil sana çok yakın! (" .. math.floor(dist) .. "m)", Duration = 3 })
            elseif dist > 25 then
                MurdererWarned = false
            end
        end
        
        if Toggles.AntiKill and dist <= 10 then
            LocalPlayer.Character.HumanoidRootPart.CFrame = LocalPlayer.Character.HumanoidRootPart.CFrame + Vector3.new(0, 25, 0)
        end
    end
end)

