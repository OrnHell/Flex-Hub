-- Auto Grab Gun Loop
task.spawn(function()
    while true do
        task.wait(0.2)
        if Toggles.AutoGrabGun and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
            local gunDrop = GetDroppedGun()
            if gunDrop then
                local hrp = LocalPlayer.Character.HumanoidRootPart
                local oldCFrame = hrp.CFrame
                local gunPos = gunDrop:IsA("BasePart") and gunDrop.CFrame or gunDrop.Handle.CFrame
                
                local tween = TweenService:Create(hrp, TweenInfo.new(0.5, Enum.EasingStyle.Linear), {CFrame = gunPos})
                tween:Play()
                tween.Completed:Wait()
                task.wait(0.2)
                hrp.CFrame = oldCFrame
            end
        end
    end
end)

-- Kill All Loop
